# --- Supabase (provisioned via Vercel Marketplace in Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: live stream URL. Hub's "Watch" tile is hidden when unset. ---
LIVE_STREAM_URL=

# --- Today-page join links. Shown on schedule rows whose location mentions
# "Conference Call" / "Zoom"; hidden when unset. The phone value may embed
# the access code so it dials straight in, e.g. +13135551234,,123456#
# The Zoom URL should be the full invite link including ?pwd=… so tapping it
# joins without a passcode prompt. ---
NEXT_PUBLIC_CONFERENCE_PHONE=
NEXT_PUBLIC_ZOOM_URL=

# --- Prayer routing (Phase 3) ---
PRAYER_TEAM_EMAIL=
PRAYER_TEAM_FROM=
RESEND_API_KEY=

# --- Notification emails ---
# Pastoral-role profiles always receive prayer/feedback notifications by
# default; EVENT_APPROVER_EMAILS is a comma-separated bootstrap list that is
# also treated as pastoral. Custom recipient lists are managed in the portal
# at /portal/notifications. The *_FROM addresses default to onboarding@resend.dev.
EVENT_APPROVER_EMAILS=
EVENT_SIGNUP_FROM=
FEEDBACK_FROM=

# --- Welcome team ---
# Where guest connect cards go: an "I'm New Here" submission, or a first-time
# or returning guest checking in (check-in files the card automatically).
# Unset = the notification is skipped and only the Supabase row is written.
WELCOME_TEAM_EMAIL=
WELCOME_TEAM_FROM=

# --- Meet with the Pastor ---
# Where new meeting requests are sent so the office can schedule them.
# Defaults to slester@nehtemple.org; the FROM defaults to
# office@nehtemple.org (the Resend-verified domain).
PASTOR_OFFICE_EMAIL=
PASTOR_OFFICE_FROM=

# --- Bishop-only prayer requests ---
# "Bishop only" requests route to and are visible only to these address(es)
# (comma-separated allowed). Unset = bishop-only emails are skipped (requests
# are still saved; only a signed-in account matching this email can view them).
BISHOP_EMAIL=

# --- Event reminder cron (vercel.json: daily /api/cron/reminders, 12:00 UTC) ---
# CRON_SECRET authenticates the cron request (Vercel sends it automatically
# once set). REMINDER_HOURS_BEFORE defaults to 36 so the daily morning run
# covers everything happening through tomorrow evening (Hobby plans only
# allow daily crons; on Pro you could go hourly with a 24h window).
CRON_SECRET=
REMINDER_HOURS_BEFORE=

# --- Check-in summary cron (/api/cron/checkin-summary) ---
# Emails attendance metrics once a service's check-in window closes.
# Recipients are managed at /portal/notifications ("Check-in summaries");
# empty = everyone with the pastoral role. Scheduled two ways: the daily
# Vercel cron in vercel.json plus a 15-minute pg_cron job in Supabase (see
# supabase/migrations/20261029010000_checkin_summary_schedule.sql) for
# near-real-time delivery. Reuses CRON_SECRET above.
# ATTENDANCE_FROM defaults to attendance@nehtemple.org (the Resend-verified
# domain) — Resend's onboarding@resend.dev sender can only mail the account
# owner, so a real recipient list needs the verified domain.
# CHECKIN_SUMMARY_LOOKBACK_DAYS defaults to 3 (how far back a run sweeps for
# closed windows it hasn't emailed yet).
ATTENDANCE_FROM=
CHECKIN_SUMMARY_LOOKBACK_DAYS=

# --- Google Calendar push ---
# Published events are inserted/updated/removed on this calendar. Share the
# calendar with the service account (GCP_SERVICE_ACCOUNT_EMAIL or the JSON
# key's client_email) with "Make changes to events", then set the calendar id
# (…@group.calendar.google.com). Unset = calendar push is a no-op.
GOOGLE_CALENDAR_ID=

# --- Ignite Youth parent & family update form (temporary promo) ---
# Both are optional; the defaults live in lib/ignite-form.ts. CLOSE_DATE is a
# Detroit wall-clock "YYYY-MM-DDTHH:MM" — past it, the Tap Hub card hides and
# /ignite/parent-update shows a "closed" screen. Submissions are never removed.
# Set ENABLED=false to pull the promotion early. Leave CLOSE_DATE empty to keep
# the form open indefinitely.
IGNITE_PARENT_FORM_ENABLED=true
IGNITE_PARENT_FORM_CLOSE_DATE=2026-12-31T23:59
# Where the "new parent update" heads-up goes. Unset = no email is sent (the
# form still works); the email never contains child details either way.
IGNITE_TEAM_EMAIL=
IGNITE_TEAM_FROM=

# --- Google sign-in + Workspace group roles ---
# ADMIN_ALLOWED_DOMAINS gates ELIGIBILITY for lead/pastoral and for
# capabilities; it is not a sign-in gate (members use any email). Defaults to
# nehtemple.org, which is also hard-coded in the profiles_staff_domain_check
# constraint — adding a second domain means a migration too.
ADMIN_ALLOWED_DOMAINS=nehtemple.org
# Origin fallback for auth redirects when there is no request to read.
NEXT_PUBLIC_SITE_URL=
#
# These two are read ONLY by `supabase config push` to fill
# [auth.external.google]; the app never uses them at runtime, so they belong in
# .env.local and not in Vercel.
GOOGLE_OAUTH_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
#
# Workspace group -> portal access, comma-separated `group=grant`, where grant
# is `pastoral`, `lead:<Ministry>`, or `cap:<capability>`. Read at every Google
# sign-in; membership is authoritative, so removing someone from a group
# revokes it on their next sign-in. Unset = roles stay manual.
# Requires the service account to hold the Workspace "Groups Reader" admin role.
PORTAL_ROLE_GROUPS=

# --- LLM admin agent (Phase 5) ---
AI_GATEWAY_API_KEY=
AGENT_ALLOWED_DOMAIN=nehtemple.com
TWILIO_AUTH_TOKEN=
RESEND_INBOUND_SECRET=
GOOGLE_CHAT_VERIFICATION_TOKEN=
